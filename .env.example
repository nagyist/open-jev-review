# Selects BOTH the review client and the single Docker Compose model service.
REVIEW_PROVIDER=openjev
OPENJEV_BASE_URL=http://127.0.0.1:8009
KEV_BASE_URL=http://127.0.0.1:8009
# Optional API model name (defaults: openjev-local / kev-latest).
# REVIEW_MODEL=kev-latest

# Docker Compose loads only the selected provider's checkpoint.
OPENJEV_MODEL=alanhuangya/OpenJev-1.7B
KEV_MODEL=jaredpalmer/kev-4b@v1.0
